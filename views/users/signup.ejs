<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">Sign up on wonderlust</h1>
  <div class="col-6 offset-3">
    <form action="/users/signup" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input name="username" type="text" class="form-control" required />
        <div class="valid-feedback">Title looks Good!</div>
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input name="email" type="email" class="form-control" required />
      </div>
        <label for="password" class="form-label">password</label>
        <input name="password" type="password" class="form-control" required />
      </div>
      <button class="btn btn-success mt-3 mx-5" style="width:15%;position:absolute;right:50%;top:450px;">Sign up</button>
    </form>
  </div>
</div> 