<% layout("/layouts/boilerplate.ejs") %><%= success %>

    <!-- <form action="/listing/new" method="get">
      <button>Create New Listing</button>
    </form> -->

    <style>
#filters {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 0.8rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    margin-top:1.5rem;
}

.filter {
    text-align: center;
    opacity: 0.7;
    min-width: 65px;
    flex-shrink: 0;
}

.filter:hover {
    cursor: pointer;
    opacity: 1;
}

.filter p {
    font-size: 0.8rem;
    margin: 0;
}

.tax-toggle {
    margin-left: auto;
    border: 1px solid #ddd;
    border-radius: 1rem;
    padding: 0.6rem 1rem;
    display: flex;
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
} 
    </style>
    <div id="filters">
      <div class="filter">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
      </div>
      <div class="filter">
        <i class="fa-solid fa-fire"></i>
        <p>Rooms</p>
      </div>  
      <div class="filter">
       <i class="fa-solid fa-mountain-city"></i>
        <p>Iconic Cities</p>
      </div>  
      <div class="filter">
       <i class="fa-solid fa-mountain"></i>
        <p>Mountains</p>
      </div>  
      <div class="filter">
       <i class="fa-brands fa-fort-awesome"></i>
        <p>Castles</p>
      </div>  
      <div class="filter">
       <i class="fa-solid fa-person-swimming"></i>
        <p>Amazing pools</p>
      </div> 
      <div class="filter">
       <i class="fa-solid fa-campground"></i>
        <p>Camping</p>
      </div> 
      <div class="filter">
       <i class="fa-solid fa-cow"></i>
        <p>Forms</p>
      </div> 
      <div class="filter">
       <i class="fa-regular fa-snowflake"></i>
        <p>Arctic</p>
      </div> 
      <div class="filter">
       <i class="fa-solid fa-igloo"></i>
        <p>Domes</p>
      </div> 
      <div class="filter">
       <i class="fa-solid fa-ship"></i>
        <p>Boats</p>
      </div> 

      <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
          <input type="checkbox" class="form-check-input" role="switch" id="flexSwitchCheckedefault">
          <label for="flexSwitchCheckDefault" class="form-check-label">Display Taxes</label>
        </div>
      </div> 
    </div>  
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for(let listing of allListings) {%>
    <a href="/listings/<%=listing._id%>" class="listing-link">
    <div class="card col listing-card">
      <img src="<%=listing.image.url%>" class="card-img-top" alt="listing_image" style="height:20rem">
      <div class="card-img-overlay"></div>
      <div class="card-body">
        <p class="card-test">
          <b><%= listing.title %></b>
          <br>
          &#8377;<%= listing.price.toLocaleString("en-IN") %> /night
          <i class="tax-info">&nbsp; &nbsp;gf +18% GST</i>
        </p>
      </div>
    </div> 
  </a>
    <%}%>
</div>
</body> 

<script>
  let taxSwitch = document.getElementById("flexSwitchCheckDefault");
  taxSwitch.addEventListener("click", () => {
      let taxinfo = document.getElementsByClassName("tax-info");
      for(info of taxinfo) {
        if(info.style.display != "inline")
          info.style.display = "inline";
        else 
          info.style.display = "none";
      }
  })
</script>