<% layout("/layouts/boilerplate") %>

<script>
  const maptoken = "<%= process.env.MAP_TOKEN %>";
  const listing = "<%= JSON.stringify(listing) %>";
</script> 

<div class="row mt-4">

  <div class="col-8 offset-3">
    <h2 class="fw-bold mb-3"><%= listing.title %></h2>
  </div>

<div class="card col-6 offset-3 show-card listing-card" style="width: 30rem">
    <img
      src="<%=listing.image.url%>"
      class="card-img-top show-img"
      alt="Listing_image"
    />

    <div class="card-body">

      <p class="text-muted">
        Owned by <strong><%= listing.owner.username %></strong>
      </p>

      <p class="card-text">
        <%= listing.description %>
      </p>

      <h5 class="text-success">
        &#8377;<%= listing.price.toLocaleString("en-IN") %>
      </h5>

      <p class="mb-1">
        <i class="fa-solid fa-location-dot text-danger"></i>
        <%= listing.location %>,
        <%= listing.country %>
      </p>

    </div>

  </div>

</div>

<br>

<% if(currUser && listing.owner._id.equals(currUser._id)) { %>

<div class="row mb-4">

  <div class="col-8 offset-3 d-flex gap-2">

    <a
      href="/listings/<%= listing._id %>/edit"
      class="btn btn-dark"
    >
      Edit
    </a>

    <form
      action="/listings/<%= listing._id %>?_method=DELETE"
      method="POST"
    >
      <button class="btn btn-danger">
        Delete
      </button>
    </form>

  </div>

</div>

<% } %>

<div class="row">

<div class="col-8 offset-3">

<% if(currUser) { %>

<h4 class="mb-3">Leave a Review</h4>

<form
action="/listings/<%= listing._id %>/reviews"
method="POST"
class="needs-validation"
novalidate
>

<div class="mb-3">

<label class="form-label fw-bold">
Rating
</label>

<div class="btn-group" role="group">

<input
type="radio"
class="btn-check"
name="review[rating]"
id="rate1"
value="1"
/>

<label
class="btn btn-outline-danger"
for="rate1"
>
1 ★
</label>

<input
type="radio"
class="btn-check"
name="review[rating]"
id="rate2"
value="2"
/>

<label
class="btn btn-outline-warning"
for="rate2"
>
2 ★
</label>

<input
type="radio"
class="btn-check"
name="review[rating]"
id="rate3"
value="3"
/>

<label
class="btn btn-outline-info"
for="rate3"
>
3 ★
</label>

<input
type="radio"
class="btn-check"
name="review[rating]"
id="rate4"
value="4"
/>

<label
class="btn btn-outline-primary"
for="rate4"
>
4 ★
</label>

<input
type="radio"
class="btn-check"
name="review[rating]"
id="rate5"
value="5"
checked
/>

<label
class="btn btn-outline-success"
for="rate5"
>
5 ★
</label>

</div>

</div>

<div class="mb-3">

<label
for="comment"
class="form-label"
>
Comment
</label>

<textarea
name="review[comment]"
id="comment"
rows="4"
class="form-control"
required
></textarea>

<div class="invalid-feedback">
Please enter a review.
</div>

</div>

<button class="btn btn-dark">
Submit Review
</button>

</form>

<% } %>

<hr class="my-5">

<% if(listing.reviews.length > 0) { %>

<h3 class="fw-bold mb-4">
Guest Reviews
</h3>

<div class="row row-cols-1 row-cols-md-2 g-4">

<% for(let review of listing.reviews) { %>

<div class="col">

<div class="card h-100 border-0 shadow-sm rounded-4">

<div class="card-body">

<div class="d-flex justify-content-between align-items-center">

<h5 class="card-title mb-0">
<i class="fa-solid fa-circle-user text-secondary me-2"></i>
<%= review.author.username %>
</h5>

<span class="badge bg-warning text-dark rounded-pill">
⭐ <%= review.rating %>/5
</span>

</div>

<hr>

<p class="card-text text-muted">
<%= review.comment %>
</p>

</div>

<% if(currUser && review.author._id.equals(currUser._id)) { %>

<div class="card-footer bg-white border-0">

<form
action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
method="POST"
>

<button
class="btn btn-outline-danger w-100 rounded-pill"
>
Delete Review
</button>

</form>

</div>

<% } %>

</div>

</div>

<% } %>

</div>

<% } %>

</div>

</div>

<div class="row mt-2">

<div class="col-8 offset-3">

<h3 class="mb-3">
Where you'll be
</h3>

<div id="map" class="mb-3"></div>

</div>

</div>

<script src="/js/map.js"></script> 